{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext", // Change this line to 'NodeNext'
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
